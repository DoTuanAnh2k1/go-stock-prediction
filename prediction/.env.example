# ---------------------------------------------------------------------------
# Python Prediction Service — Environment Variables
# Copy this file to .env and adjust values for your environment.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# gRPC Server
# ---------------------------------------------------------------------------
GRPC_SERVER_PORT=8119

# ---------------------------------------------------------------------------
# Database (MySQL)
# Must match the MySQL service reachable from this container/host.
# ---------------------------------------------------------------------------
DB_DRIVER=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123
MYSQL_DB_NAME=go_stock_prediction
# Set to true to echo all SQL queries in logs (useful for debugging)
MYSQL_DEBUG=false

# ---------------------------------------------------------------------------
# Logging
# Supported levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# (Informational only — used by Go API service, ignored by Python service)
# These are listed here so a single .env file can be shared across services.
# ---------------------------------------------------------------------------
# SERVER_PORT=8118
# GRPC_TARGET=localhost:8119
# API_KEY=
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123
# JWT_SECRET=change-me-in-production
