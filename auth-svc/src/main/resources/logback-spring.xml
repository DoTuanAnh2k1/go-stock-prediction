<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Pull in Spring Boot's color (%clr) conversion rules and defaults -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Single-line colored console appender. Colors are forced ON via
         spring.output.ansi.enabled=always in application.yml (Docker is non-TTY). -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%clr(%d{yyyy-MM-dd'T'HH:mm:ss}){faint} %clr([%-5level]){highlight} %clr(request_id=%X{requestId:-}){magenta} %clr(%logger{20}){cyan} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <logger name="vn.gostock" level="INFO"/>
    <logger name="net.devh.boot.grpc" level="WARN"/>
</configuration>
