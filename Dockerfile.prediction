# Build stage
FROM golang:1.25-alpine AS builder
RUN apk add --no-cache git make
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o prediction-server ./cmd/prediction

# Run stage
FROM alpine:latest
RUN apk add --no-cache ca-certificates tzdata
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
WORKDIR /app
COPY --from=builder /app/prediction-server .
USER appuser
EXPOSE 8119
ENTRYPOINT ["./prediction-server"]
