# ====================================================
# go-stock-prediction — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ====================================================

# ============ Database ============
MYSQL_ROOT_PASSWORD=change-me-strong-root-password
MYSQL_USER=dbuser
MYSQL_PASSWORD=change-me-strong-db-password

# ============ Auth ============
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-admin-password
JWT_SECRET=change-me-run-openssl-rand-base64-48

# ============ CORS ============
# Comma-separated list of allowed frontend origins.
# For dev: http://localhost:36018
# For prod: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:36018

# ============ Logging ============
LOG_LEVEL=INFO
DB_LOG_LEVEL=WARN
MYSQL_DEBUG=false
