# ====================================================
# go-stock-prediction — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ====================================================

# ============ Database — database-per-service ============
# One TimescaleDB instance, THREE isolated databases, one least-privilege role each.
# The db container's init script (deploy/db-init) creates the roles/databases from these.
POSTGRES_PASSWORD=change-me-strong-superuser    # postgres superuser (db admin only)
AUTH_DB_PASSWORD=change-me-strong-auth           # role auth_svc       -> auth_db
MARKET_DB_PASSWORD=change-me-strong-market       # role prediction_svc -> market_db
REGISTRY_DB_PASSWORD=change-me-strong-registry   # role service_mgt    -> registry_db
API_DB_PASSWORD=change-me-strong-api             # role api_svc (read-only) -> market_db

# ============ pgAdmin ============
PGADMIN_DEFAULT_PASSWORD=change-me-strong-pgadmin

# ============ Super-Admin Seed (auth-svc) ============
# Java Auth Service reads these at startup and fails fast if blank or weak.
# Username is not sensitive; password must be strong.
SUPER_ADMIN_USERNAME=chon
SUPER_ADMIN_PASSWORD=change-me-strong-admin-password

# ============ Auth / Secrets ============
# Generate strong values with: openssl rand -base64 48
JWT_SECRET=change-me-run-openssl-rand-base64-48
INTERNAL_SECRET=change-me-run-openssl-rand-base64-48

# ============ MinIO / S3 Model Store ============
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-strong

# ============ CORS ============
# Allowed frontend origin for CORS. Must match the public URL of the frontend.
# Self-signed / local:  https://localhost
# Tailscale:            https://<machine>.ts.net
# Domain / cloud:       https://yourdomain.com
ALLOWED_ORIGINS=https://localhost

# ============ Logging ============
LOG_LEVEL=INFO
DB_LOG_LEVEL=WARN
