# Copy this file to values-secret.yaml (git-ignored) and fill in real values.
# Apply with: helm upgrade cronjobs deploy/helm/cronjobs -n stock -f values-secret.yaml
#
# These MUST match auth-svc's seeded super_admin (SUPER_ADMIN_USERNAME/PASSWORD),
# because the simulation CronJob logs in as super_admin to trigger the live step.
#
# NEVER commit values-secret.yaml to git.
secrets:
  superAdminUsername: REPLACE_ME     # == auth-svc super_admin username
  superAdminPassword: REPLACE_ME     # == auth-svc super_admin password
