# Copy this file to values-secret.yaml (git-ignored) and fill in real values.
# Apply with: helm upgrade auth-svc deploy/helm/auth-svc -n stock -f values-secret.yaml
#
# Generate strong values:
#   jwtSecret / internalSecret: openssl rand -base64 48  (MUST match api-svc values)
#   postgresPassword: openssl rand -base64 32             (auth_svc role in auth_db)
#
# NEVER commit values-secret.yaml to git.
secrets:
  postgresPassword: REPLACE_ME_auth_svc     # auth_svc role password for auth_db
  jwtSecret: REPLACE_ME                     # MUST match api-svc jwtSecret
  internalSecret: REPLACE_ME               # MUST match api-svc/cli-svc internalSecret
  superAdminPassword: REPLACE_ME
