# Copy real secrets here; apply with: helm upgrade auth-svc deploy/helm/auth-svc ... -f values-secret.yaml (git-ignored)
# Generate strong values:
#   jwtSecret:          openssl rand -base64 48  (MUST match api-svc jwtSecret)
#   internalSecret:     openssl rand -base64 48  (MUST match api-svc/cli-svc internalSecret)
#   superAdminPassword: choose a strong password (min 12 chars)
secrets:
  jwtSecret: REPLACE_ME
  internalSecret: REPLACE_ME
  superAdminPassword: REPLACE_ME
