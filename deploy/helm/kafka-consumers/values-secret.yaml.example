# kafka-consumers — secret values (DO NOT COMMIT the real values-secret.yaml).
# Copy this file to values-secret.yaml, fill in real passwords, then:
#   helm install kafka-consumers deploy/helm/kafka-consumers -n stock \
#     -f deploy/helm/kafka-consumers/values-secret.yaml
#
# postgresPassword: prediction_svc role password for market_db.
#   Must match:
#     - prediction-svc secrets.postgresPassword
#     - db chart db.marketDbPassword
secrets:
  postgresPassword: "REPLACE_ME"
