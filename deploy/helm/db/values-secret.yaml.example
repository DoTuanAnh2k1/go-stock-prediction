# Copy this file to values-secret.yaml (git-ignored) and fill in real values.
# Apply with: helm upgrade db deploy/helm/db -n stock -f values-secret.yaml
#
# Generate strong passwords:
#   openssl rand -base64 32
#
# NEVER commit values-secret.yaml to git.
secrets:
  postgresPassword: REPLACE_ME_superuser
  authDbPassword: REPLACE_ME_auth_svc
  marketDbPassword: REPLACE_ME_market_db
  registryDbPassword: REPLACE_ME_service_mgt
  apiDbPassword: REPLACE_ME_api_svc
