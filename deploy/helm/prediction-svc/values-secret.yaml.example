# Copy this file to values-secret.yaml (git-ignored) and fill in real values.
# Apply with: helm upgrade prediction-svc deploy/helm/prediction-svc -n stock -f values-secret.yaml
#
# postgresPassword: prediction_svc role password for market_db
# s3AccessKey / s3SecretKey MUST match the minio chart secrets (MINIO_ROOT_USER / MINIO_ROOT_PASSWORD).
#
# NEVER commit values-secret.yaml to git.
secrets:
  postgresPassword: REPLACE_ME_prediction_svc   # prediction_svc role password for market_db
  s3AccessKey: REPLACE_ME
  s3SecretKey: REPLACE_ME
