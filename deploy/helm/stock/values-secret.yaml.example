# =============================================================================
# values-secret.yaml.example — MẪU override credentials cho production (CKAD C2).
#
# CÁCH DÙNG:
#   cp deploy/helm/stock/values-secret.yaml.example deploy/helm/stock/values-secret.yaml
#   # điền credential THẬT vào bản copy (bản .yaml đã bị .gitignore — KHÔNG commit)
#   helm upgrade --install stock deploy/helm/stock -n stock \
#     -f deploy/helm/stock/values-secret.yaml
#
# Giá trị trong values.yaml (`global.secrets.*`) chỉ là PLACEHOLDER dev an toàn để
# stack chạy out-of-the-box; production PHẢI override qua file này (hoặc secret
# manager / --set / SealedSecrets). Vì file thật bị gitignore → không có credential
# thật nào commit vào git (tránh điều kiện auto-fail "Secrets committed in plaintext").
# =============================================================================
global:
  secrets:
    postgresUser: postgres
    postgresPassword: "CHANGE_ME_strong_db_password"
    postgresDb: go_stock_prediction
    jwtSecret: "CHANGE_ME_min_32_char_random_secret"      # phải GIỐNG giữa api-svc & auth-svc
    internalSecret: "CHANGE_ME_internal_upsert_secret"
    adminPassword: "CHANGE_ME_admin_password"
    s3AccessKey: "CHANGE_ME_minio_access_key"
    s3SecretKey: "CHANGE_ME_minio_secret_key"
    minioRootUser: "CHANGE_ME_minio_root_user"
    minioRootPassword: "CHANGE_ME_minio_root_password"
    pgadminPassword: "CHANGE_ME_pgadmin_password"
